{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUncheckedSideEffectImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": [
      "vite/client"
    ],
    "noEmit": true
  },
  "include": [
    "src",
    "vendor/jello-mobile-navbar-react/src",
    "vendor/jello-call-to-action-react/src",
    "vendor/jello-solid-link-react/src",
    "vendor/jello-desktop-glass-react/src",
    "vendor/jello-desktop-solid-react/src"
  ]
}
