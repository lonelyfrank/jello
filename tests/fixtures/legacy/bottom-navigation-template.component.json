      "geometry": {
        "shape": "capsule",
        "width": 280,
        "height": 104,
        "radius": 32
      },
      "behavior": {
        "stiffness": 420,
        "damping": 0.8,
        "stretch": 0,
        "pressScale": 1.02,
        "pressRefraction": 0.4,
        "pressLight": 0.45
      },
      "quality": {
        "profile": "balanced",
        "dprCap": null,
        "internalScale": null,
        "adaptive": false
      },
      "source": {
        "kind": "dom"
      },
      "target": {
        "backend": "auto",
        "fallback": "css"
      },
      "meta": {
        "createdAt": null,
        "updatedAt": null,
        "basedOn": "navbar",
        "notes": "Calibrato sulla navbar del laboratorio (barra larga e bassa sopra contenuti che scorrono): fascia stretta, rifrazione moderata sul perimetro, centro neutro e leggibile, blur medio. Pressione con poca scala, più luce."
      }
    }
  },
  "root": {
