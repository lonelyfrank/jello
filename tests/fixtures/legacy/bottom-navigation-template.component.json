      "widthMode": "fill",
      "width": 440,
      "maxWidth": 440,
      "height": 64,
      "padding": 6,
      "gap": 2,
      "radius": "capsule",
      "offset": 12,
      "itemLayout": "stacked",
      "labels": "show"
