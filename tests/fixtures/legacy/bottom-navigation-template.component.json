      "runtime": {
        "min": "0.2.0"
      },
      "material": {
        "band": 16,
        "refraction": 10,
        "profile": "smooth",
        "dome": 0,
        "chroma": 0,
        "blur": 4,
        "saturation": 160,
        "tint": "#ffffff",
