{
  "name": "jello",
  "private": true,
  "version": "0.3.0",
  "description": "Jello Material Lab: laboratorio di materiali per componenti UI (runtime Glass, editor, export).",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json && node scripts/finalize-lib.mjs",
    "build": "npm run build:lib && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:local": "playwright test --project=chromium --project=firefox --project=mobile-emulated",
    "test:perf": "npm run build && node scripts/perf.mjs",
    "relay": "node tools/relay/relay.mjs",
    "example:prepare": "npm run build:lib && node scripts/prepare-example.mjs",
    "example:serve": "node scripts/serve-static.mjs examples/navbar 4175",
    "android:sync": "npm --prefix apps/android-preview run sync",
    "geometry:cases": "node --experimental-strip-types --no-warnings scripts/geometry-cases.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run test:e2e:local",
    "consumer:prepare": "npm run build:lib && node scripts/prepare-consumer.mjs",
    "consumer:serve": "node scripts/serve-static.mjs examples/react-consumer/dist 4176"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fake-indexeddb": "^6.2.6",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  }
}
