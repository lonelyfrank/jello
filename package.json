{
  "name": "jello",
  "private": true,
  "version": "0.1.0",
  "description": "Jello Glass Lab: materiale glass dinamico per il web (nucleo + laboratorio).",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:local": "playwright test --project=chromium --project=firefox --project=mobile-emulated",
    "test:perf": "vite build && node scripts/perf.mjs",
    "geometry:cases": "node --experimental-strip-types --no-warnings scripts/geometry-cases.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run test:e2e:local"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
